## 4. Minimal Working App: `app.py`

```python
import streamlit as st
from openai import OpenAI

st.set_page_config(
    page_title="AI Workplace Productivity Assistant",
    page_icon="🤖",
    layout="wide"
)

if "OPENAI_API_KEY" not in st.secrets:
    st.error("Please add OPENAI_API_KEY to Streamlit secrets.")
    st.stop()

client = OpenAI(api_key=st.secrets["OPENAI_API_KEY"])

ASSISTANTS = {
    "Email Generator": {
        "system": "You are a professional email assistant. Write clear, polite, concise emails. Include subject line, greeting, body, and sign-off. Ask for missing details if needed.",
        "placeholder": "Recipient: ...\nGoal: ...\nTone: formal/friendly\nKey points: ..."
    },
    "Meeting Summarizer": {
        "system": "You summarize meeting notes. Output: 1) 3-sentence overview, 2) key decisions, 3) action items table with owner, task, deadline, 4) risks or open questions. Do not invent facts.",
        "placeholder": "Paste meeting transcript or notes here..."
    },
    "Task Planner": {
        "system": "You are a project manager. Given a goal, deadline, and constraints, create a prioritized plan with milestones, daily tasks, dependencies, and risk buffer. Use a table.",
        "placeholder": "Goal: ...\nDeadline: ...\nConstraints: ...\nAvailable hours per day: ..."
    },
    "Research Assistant": {
        "system": "You provide balanced research briefs. Include key concepts, pros/cons, current trends, 3 credible source types, and open questions. Flag uncertainty. Do not fabricate citations.",
        "placeholder": "Topic: ...\nAudience: ...\nDepth: brief/detailed"
    },
    "Workplace Chatbot": {
        "system": "You are a workplace productivity coach. Ask clarifying questions, give step-by-step advice, respect privacy, and refuse unethical requests.",
        "placeholder": "Ask a productivity question..."
    }
}

def run_assistant(system_prompt, user_input):
    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_input}
        ],
        temperature=0.7
    )
    return response.choices[0].message.content

st.title("🤖 AI-Powered Workplace Productivity Assistant")
st.caption("Email generation • Meeting summaries • Task planning • Research • Chatbot")

choice = st.sidebar.selectbox("Choose a tool", list(ASSISTANTS.keys()))
info = ASSISTANTS[choice]

user_input = st.text_area(
    "Enter your input",
    placeholder=info["placeholder"],
    height=220
)

if st.button("Generate", type="primary"):
    if not user_input.strip():
        st.warning("Please enter some input.")
    else:
        with st.spinner("Working..."):
            output = run_assistant(info["system"], user_input)
        st.subheader("Result")
        st.markdown(output)
        st.download_button(
            "Download result",
            output,
            file_name=f"{choice.lower().replace(' ', '_')}.md"
        )
